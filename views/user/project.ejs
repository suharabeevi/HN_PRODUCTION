document.getElementById("contact-form").addEventListener("submit", function(e) {
    e.preventDefault();

    var name = document.querySelector("input[name='Name']").value;
    var company = document.querySelector("input[name='Company']").value;
    var email = document.querySelector("input[name='E-mail']").value;
    var phone = document.querySelector("input[name='Phone']").value;
    var message = document.querySelector("textarea[name='Message']").value;

    var whatsappNumber = "447767599149"; // 👉 Replace with your WhatsApp number (with country code, no +)

    var text = 
        "New Project Inquiry%0A%0A" +
        "Name: " + name + "%0A" +
        "Company: " + company + "%0A" +
        "Email: " + email + "%0A" +
        "Phone: " + phone + "%0A%0A" +
        "Message:%0A" + message;

    var url = "https://wa.me/" + whatsappNumber + "?text=" + text;

    window.open(url, "_blank");
});

document.addEventListener('DOMContentLoaded', function() {
  const categoriesWrap = document.getElementById('project-categories');
  const projectListWrap = document.getElementById('project-list');
  const galleryTitle = document.getElementById('project-gallery-title');
  const galleryWrap = document.getElementById('project-gallery');

  async function loadCategories() {
    try {
      const res = await fetch('/api/project-categories');
      const data = await res.json();
      if (!data.success) return;
      const cats = data.categories || [];
      if (cats.length === 0) {
        categoriesWrap.innerHTML = '<p>No categories found</p>';
        return;
      }
      categoriesWrap.innerHTML = '';
      cats.forEach((c, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn btn-line-small';
        btn.textContent = c.name;
        btn.dataset.id = c._id;
        btn.addEventListener('click', () => loadProjects(c._id, c.name, btn));
        categoriesWrap.appendChild(btn);
        if (i === 0) loadProjects(c._id, c.name, btn);
      });
    } catch (err) { console.error('loadCategories', err); }
  }

  async function loadProjects(categoryId, categoryName, activeBtn) {
    try {
      document.querySelectorAll('#project-categories .btn').forEach(b => b.classList.remove('active'));
      if (activeBtn) activeBtn.classList.add('active');

      galleryTitle.innerHTML = categoryName ? '<span>Category</span><h2>' + categoryName + '</h2>' : '';
      projectListWrap.innerHTML = '<div class="col-12"><p>Loading projects...</p></div>';
      galleryWrap.innerHTML = '<div class="col-12"><p>Loading images...</p></div>';

      const res = await fetch('/api/projects?categoryId=' + encodeURIComponent(categoryId));
      const data = await res.json();
      if (!data.success) {
        projectListWrap.innerHTML = '<div class="col-12"><p>No projects found</p></div>';
        galleryWrap.innerHTML = '<div class="col-12"><p>No images available</p></div>';
        return;
      }
      const projects = data.projects || [];
      if (projects.length === 0) {
        projectListWrap.innerHTML = '<div class="col-12"><p>No project titles in this category.</p></div>';
        galleryWrap.innerHTML = '<div class="col-12"><p>No images in this category.</p></div>';
        return;
      }

      renderProjectTitles(projects);
      const firstBtn = projectListWrap.querySelector('.project-item-box');
      if (firstBtn) {
        firstBtn.click();
      }
    } catch (err) {
      console.error('loadProjects', err);
      projectListWrap.innerHTML = '<div class="col-12"><p>Error loading projects</p></div>';
      galleryWrap.innerHTML = '<div class="col-12"><p>Error loading images</p></div>';
    }
  }

  function renderProjectTitles(projects) {
    projectListWrap.innerHTML = '';
    projects.forEach((project, index) => {
      const item = document.createElement('div');
      item.className = 'project-item';
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'project-item-box' + (index === 0 ? ' active' : '');
      button.innerHTML = '<h3>' + project.title + '</h3>' + (project.description ? '<p>' + project.description + '</p>' : '');
      button.addEventListener('click', () => showProjectImages(project, button));
      item.appendChild(button);
      projectListWrap.appendChild(item);
    });
  }

  function showProjectImages(project, activeBtn) {
    document.querySelectorAll('#project-list .project-item-box').forEach(b => b.classList.remove('active'));
    if (activeBtn) activeBtn.classList.add('active');

    galleryTitle.innerHTML = '<span>Project</span><h2>' + project.title + '</h2>';
    const images = project.images || [];
    if (images.length === 0) {
      galleryWrap.innerHTML = '<div class="col-12"><p>No images available for this project.</p></div>';
      return;
    }

    galleryWrap.innerHTML = '';
    images.forEach(img => {
      const imageUrl = typeof img === 'string' ? img : img.url;
      const col = document.createElement('figure');
      col.className = 'col-12 col-md-6 gallery__item grid-item animate-card-2';
      col.innerHTML = '<div class="gallery__link"><img src="' + imageUrl + '" class="portfolio-img" alt="Project image"></div>';
      galleryWrap.appendChild(col);
    });
  }

  loadCategories();
});
</script>
    <!-- Load Scripts End -->
    
