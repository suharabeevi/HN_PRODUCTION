    <style>
      .portfolio-img {
        width: 100%;
        height: 420px;
        object-fit: cover;
        border-radius: 12px;
      }

      @media (max-width: 768px) {
        .portfolio-img {
          height: 280px;
        }
      }

      .project-categories {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 2rem;
      }

      .project-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.2rem;
        margin-bottom: 2rem;
      }

      .project-item {
        min-width: 0;
      }

      .project-item-box {
        width: 100%;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        padding: 1.2rem 1.4rem;
        color: #ffffff;
        text-align: left;
        cursor: pointer;
        transition: transform 0.25s ease, background-color 0.25s ease, border-color 0.25s ease,
          color 0.25s ease, box-shadow 0.25s ease;
        font-size: 0.95rem;
        font-family: inherit;
      }

      .project-item-box:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-2px);
      }

      .project-item-box.active {
        background: rgba(255, 255, 255, 0.14);
        border-color: rgba(255, 255, 255, 0.22);
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.14);
      }

      .project-item-box.active h3,
      .project-item-box.active p {
        color: #ffffff;
      }

      .project-item-box h3 {
        margin: 0 0 0.35rem;
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: 0.01em;
      }

      .project-item-box p {
        margin: 0;
        color: rgba(255, 255, 255, 0.72);
        font-size: 0.94rem;
        line-height: 1.6;
      }

      .project-gallery-title {
        margin-bottom: 1.4rem;
        color: #ffffff;
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .project-gallery-title span {
        display: block;
        opacity: 0.75;
        font-size: 0.88rem;
      }

      .project-gallery-title h2 {
        margin: 0.45rem 0 0;
        font-size: clamp(1.6rem, 2vw, 2.2rem);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: normal;
        text-transform: none;
      }

      #project-gallery .gallery__link {
        display: block;
        border-radius: 12px;
        overflow: hidden;
      }
    </style>
    <!-- Custom Browser Color End -->
